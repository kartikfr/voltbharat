{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "VOLT Bharat intelligence blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "coverImage": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false,
      "required": false
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "POLICY_PULSE",
        "MARKET_TRENDS",
        "IPO_WATCH",
        "SUBSIDY_DECODER",
        "CLEAN_TECH_UPDATES"
      ],
      "required": true,
      "default": "POLICY_PULSE"
    },
    "author": {
      "type": "string",
      "required": true
    },
    "impact": {
      "type": "text"
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 70
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    }
  }
}
